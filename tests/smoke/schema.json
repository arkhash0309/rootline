{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cluster smoke file (overview §7.7, gate check G12)",
  "description": "One file tests/smoke/<component>.yaml per deployed component. File name must equal <component>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "checks"],
  "properties": {
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Component name in lowercase with hyphens, for example api or mcp-k8s."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "namespace", "service", "port", "path", "expect_status"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "kind": {"const": "http"},
              "namespace": {"type": "string", "minLength": 1},
              "service": {"type": "string", "minLength": 1},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "path": {"type": "string", "pattern": "^/"},
              "expect_status": {"type": "integer", "minimum": 100, "maximum": 599}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "namespace", "pod_selector", "container", "command", "expect_exit"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "kind": {"const": "exec"},
              "namespace": {"type": "string", "minLength": 1},
              "pod_selector": {"type": "string", "minLength": 1, "description": "Label selector passed to kubectl -l."},
              "container": {"type": "string", "minLength": 1},
              "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "expect_exit": {"type": "integer", "minimum": 0, "maximum": 255}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "app", "expect"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "kind": {"const": "argocd_app"},
              "app": {"type": "string", "minLength": 1},
              "expect": {"const": "Synced/Healthy"}
            }
          }
        ]
      }
    }
  }
}
